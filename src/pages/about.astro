---
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Hero4 from '~/components/widgets/Hero4.astro';
//import Stats from '~/components/widgets/Stats.astro';
import Steps from '~/components/widgets/Steps.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About us',
};

const biblio = [
  {
    title: 'The use of virtual reality to influence motivation, affect, enjoyment, and engagement during exercise',
    description:
      'Mouatt, B., Smith, A. E., Mellow, M. L., Parfitt, G., Smith, R. T., & Stanton, T. R. (2020). The use of virtual reality to influence motivation, affect, enjoyment, and engagement during exercise: A scoping review. Frontiers in Virtual Reality',
    link: 'https://doi.org/10.3389/frvir.2020.564664',
  },
  {
    title: 'Attractiveness of game elements',
    description:
      'Qin, Y. (2021). Attractiveness of game elements, presence, and enjoyment of mobile augmented reality games: The case of Pokémon Go. Telematics and Informatics, 62, 101620',
    link: 'https://doi.org/10.1016/j.tele.2021.101620',
  },
  {
    title: 'The bright and dark sides of motivation as predictors of enjoyment, intention, and exercise persistence.',
    description:
      'Rodrigues, F., Teixeira, D. S., Neiva, H. P., Cid, L., & Monteiro, D. (2019). The bright and dark sides of motivation as predictors of enjoyment, intention, and exercise persistence. Scandinavian Journal of Medicine and Science in Sports, 30(4), 787–800',
    link: 'https://doi.org/10.1111/sms.13617',
  },
  {
    title: 'Small-Sided Games are More Enjoyable Than High-Intensity Interval Training of Similar Exercise Intensity',
    description:
      'Selmi, O., Ouergui, I., Levitt, D. E., Nikolaidis, P. T., Knechtle, B., & Bouassida, A. (2020). Small-Sided Games are More Enjoyable Than High-Intensity Interval Training of Similar Exercise Intensity in Soccer Open Access Journal of Sports Medicine, Volume 11, 77–84',
    link: 'https://doi.org/10.2147/oajsm.s244512',
  },
];
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero4
    tagline="Objetivo",
    videoLink="..public\imgs\concept.mp4",
  >
    <Fragment slot="title">
      AYUDARTE A SER FIT MIENTRAS TE DIVIERTES<br />
    </Fragment>

    <Fragment slot="subtitle">
      Actualmente, muchas personas desean mantener una rutina de ejercicio regular, pero la falta de motivación a menudo convierte el ejercicio, en una tarea tediosa que rápidamente abandonan.
    </Fragment>
  </Hero>

  <Steps
    title="La Bibliografía"
    tagline="Nos fundamenta"
    isReversed={true}
    items={biblio}
    numberList
    image={{
      src: 'https://media1.tenor.com/m/KyLkCcKPaa8AAAAC/cat-reading.gif',
      alt: 'Steps image',
    }}
  />

